{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    { "source": "/mockServiceWorker.js", "headers": [{ "key": "Service-Worker-Allowed", "value": "/" }, { "key": "Cache-Control", "value": "no-cache" }] }
  ],
  "rewrites": [{ "source": "/((?!assets/|static/|mockServiceWorker.js).*)", "destination": "/index.html" }]
}
